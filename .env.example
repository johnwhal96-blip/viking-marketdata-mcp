# Viking WebSocket API credentials
VIKING_EMAIL=user@example.com
VIKING_API_KEY=replace-me
VIKING_ROLE=trader
VIKING_WS_URL=wss://bot.fkviking.com/ws

# Protects the remote MCP endpoint. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=replace-with-a-long-random-token

# Railway sets RAILWAY_PUBLIC_DOMAIN automatically after a public domain is added.
# For local HTTP development, set:
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# Data delivery limits
INLINE_MAX_ROWS=500
INLINE_MAX_BYTES=200000
MAX_POINTS_PER_FIELD=500000
EXPORT_TTL_SECONDS=86400
EXPORT_DIR=./data/exports
VIKING_REQUEST_TIMEOUT_SECONDS=45

